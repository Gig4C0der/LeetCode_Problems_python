class Solution:
    def separateDigits(self, nums: List[int]) -> List[int]:
         a = str(nums)
         cleaned = a.strip("[]")
         c = cleaned.replace(" ", "")
         b = ''.join(str(c).split(','))
         result = list(map(int, str(b[0:8])))  
         return result




