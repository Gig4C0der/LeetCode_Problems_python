class Solution:
    def separateDigits(self, nums: List[int]) -> List[int]:
         a = str(nums)
         cleaned = a.strip("[]")
         c = cleaned.replace(" ", "")
         b = ''.join(str(c).split(','))
         result = list(map(int, str(b[0:8])))  
         return result




#Mas eficiente y profesional
class Solution:
    def separateDigits(self, nums: List[int]) -> List[int]:
         a = list(map(str, nums)) #Pasa la lista de enteros a string
         b = "".join(a) #Elimina los corchetes, las comas y los espacios
          c = list(map(int, str(b))) #Vuelve a pasar el string a entero
          return c
